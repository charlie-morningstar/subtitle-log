---
import Base from '../layouts/Base.astro';
import Pager from '../components/Pager.astro';
import { getAllPosts } from '../lib/posts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/img/${f}`;

const keys = [
  { label: 'Kernel',    href: `${base}/kernel/` },
  { label: 'CVE',       href: `${base}/cve/` },
  { label: 'Reversing', href: `${base}/reversing/` },
  { label: 'Tooling',   href: `${base}/tooling/` },
  { label: 'Notes',     href: `${base}/notes/` },
];

const posts = await getAllPosts();
const featured = posts.filter((p) => p.featured).slice(0, 3);
const latest = posts;
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="Subtitle Log — 조은진" bodyClass="desk">
  <!-- 히어로 -->
  <section class="hero">
    <div class="valance" aria-hidden="true"></div>
    <img class="curtain-img left" src={img('curtain_left.png')} alt="" aria-hidden="true" />
    <img class="curtain-img right" src={img('curtain_right.png')} alt="" aria-hidden="true" />

    <div class="sign">
      <h1>Subtitle Log</h1>
      <div class="role">Security Research Notebook</div>
    </div>

    <nav class="rack" aria-label="메뉴">
      {keys.map((k) => (
        <a class="peg" href={k.href} aria-label={k.label}>
          <span class="plate">
            <img src={img('plate.png')} alt="" aria-hidden="true" />
            <span class="plabel">{k.label}</span>
          </span>
          <img class="keyimg" src={img('key.png')} alt="" aria-hidden="true" />
        </a>
      ))}
    </nav>

    <div class="scrollcue mono"><span>아래로</span><span class="chev"></span></div>
  </section>

  <script is:inline>
    requestAnimationFrame(() => requestAnimationFrame(() => {
      document.documentElement.classList.add('anim-ready');
    }));
  </script>

  <!-- 원목 협탁 (스크롤) : 램프·화병 + 캐비닛 = Featured Posts -->
  <section class="console">
    <div class="console-inner">
      <div class="console-top">
        <img class="lamp" src={img('lamp.png')} alt="" aria-hidden="true" />
        <img class="vase" src={img('vase.png')} alt="" aria-hidden="true" />
        <img class="lamp" src={img('lamp.png')} alt="" aria-hidden="true" />
      </div>
      <div class="cabinet">
        <div class="ledger-frame">
          <div class="sect-head"><span class="placard">Featured Posts</span></div>
          <div class="plist">
            {featured.length === 0 && <div class="empty">추천 글이 곧 올라옵니다.</div>}
            {featured.map((p) => (
              <a href={p.href}>
                <span class="phead"><span class="pt">{p.title}</span><span class="pd">{fmt(p.date)}</span></span>
                <span class="ps">{p.summary}</span>
                {p.tags.length > 0 && <span class="ptags">{p.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Latest Entries : 5개씩 + 페이지 번호 -->
    <div class="latest-wrap" id="latestWrap">
      <div class="sect-head"><span class="placard">Latest Entries</span></div>
      <div class="plist" id="latestList">
        {latest.length === 0 && <div class="empty">곧 첫 기록이 새겨집니다.</div>}
        {latest.map((p, i) => (
          <a class="lrow" href={p.href} data-idx={i}>
            <span class="phead"><span class="pt">{p.title}</span><span class="pd">{fmt(p.date)}</span></span>
            <span class="ps">{p.summary}</span>
            {p.tags.length > 0 && <span class="ptags">{p.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</span>}
          </a>
        ))}
      </div>
      <Pager listId="latestList" rowSel=".lrow" per={5} />
    </div>
  </section>

  <!-- Connect (홈 하단) -->
  <footer class="home-foot">
    <div class="connect-label">Connect</div>
    <a href="mailto:subtitle8080@gmail.com">subtitle8080@gmail.com</a>
  </footer>
</Base>

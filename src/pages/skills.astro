---
import Inner from '../layouts/Inner.astro';
const groups = [
  { k: '집중 분야', v: ['Windows 커널 내부구조', '권한상승(EOP)', '정적분석'] },
  { k: '학습 중', v: ['리버싱', '익스플로잇 개발', 'OS·아키텍처'] },
  { k: '도구', v: ['IDA', 'WinDbg', 'VM 기반 분석 환경'] },
  { k: '언어', v: ['C', 'Python'] },
];
---
<Inner title="Skills" label="05 · Skills" lead="지금 할 수 있는 것과, 배우고 있는 것.">
  <div class="cards">
    {groups.map((g) => (
      <div class="card">
        <span class="ctags">{g.k}</span>
        <p class="csum">{g.v.join(' · ')}</p>
      </div>
    ))}
  </div>
</Inner>

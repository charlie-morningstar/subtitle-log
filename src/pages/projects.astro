---
import Inner from '../layouts/Inner.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const analysis = (await getCollection('analysis', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
---
<Inner
  title="Projects"
  label="02 · Projects"
  lead="직접 만들고 분석한 것들."
>
  <div class="posts">
    {analysis.length === 0 && <p class="empty-note">곧 채워집니다.</p>}
    {analysis.map((p) => (
      <a class="post" href={`${base}/analysis/${p.id}/`}>
        <span class="date">{fmt(p.data.date)}</span>
        <span>
          <h3>{p.data.title}</h3>
          <p class="mt">{p.data.summary}</p>
        </span>
      </a>
    ))}
  </div>
</Inner>

---
import Inner from '../layouts/Inner.astro';
import { mindmap } from '../data/mindmap';
---
<Inner
  title="CS Foundations"
  label="04 · CS Foundations"
  lead="커널 취약점을 이해하기 위해 다진 기반. 노드를 눌러보세요."
>
  <div class="mapwrap">
    <div class="mapgrid">
      <div id="map"><svg id="edges"></svg></div>
      <div class="panel">
        <div class="plabel">CS MINDMAP</div>
        <h3 id="p-title">노드를 선택하세요</h3>
        <div class="content" id="p-body">왼쪽 지도에서 주제를 누르면 정리한 내용이 여기에 나옵니다.</div>
      </div>
    </div>
  </div>

  <script define:vars={{ mindmap }} is:inline>
    const map = document.getElementById('map');
    const edges = document.getElementById('edges');
    const pTitle = document.getElementById('p-title');
    const pBody = document.getElementById('p-body');
    function layout() {
      map.querySelectorAll('.node').forEach((n) => n.remove());
      edges.innerHTML = '';
      const w = map.clientWidth, h = map.clientHeight, cx = w / 2, cy = h / 2;
      const R = Math.min(w, h) / 2 - 68;
      const root = document.createElement('button');
      root.className = 'node root'; root.textContent = mindmap.root;
      root.style.left = cx + 'px'; root.style.top = cy + 'px';
      root.onclick = () => select(-1, root);
      map.appendChild(root);
      mindmap.branches.forEach((b, i) => {
        const ang = -Math.PI / 2 + (i / mindmap.branches.length) * 2 * Math.PI;
        const x = cx + R * Math.cos(ang), y = cy + R * Math.sin(ang);
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', cx); line.setAttribute('y1', cy);
        line.setAttribute('x2', x); line.setAttribute('y2', y);
        line.setAttribute('stroke', 'rgba(201,163,90,.3)'); line.setAttribute('stroke-width', '1');
        edges.appendChild(line);
        const n = document.createElement('button');
        n.className = 'node'; n.textContent = b.label;
        n.style.left = x + 'px'; n.style.top = y + 'px';
        n.onclick = () => select(i, n);
        map.appendChild(n);
      });
    }
    function select(i, el) {
      map.querySelectorAll('.node').forEach((n) => n.classList.remove('active'));
      el.classList.add('active');
      if (i < 0) { pTitle.textContent = mindmap.root; pBody.textContent = '각 노드를 눌러 세부 주제를 확인하세요.'; return; }
      const b = mindmap.branches[i];
      pTitle.textContent = b.label; pBody.textContent = b.note;
    }
    layout();
    let t;
    window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(layout, 150); });
  </script>
</Inner>

---
import Base from './Base.astro';
export interface Props {
  title: string;
  label?: string;
  lead?: string;
  center?: boolean;
  flora?: boolean;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, label, lead, center = false, flora = false } = Astro.props;
const img = (f: string) => `${base}/img/${f}`;
---
<Base title={`${title} — 조은진`} bodyClass="inner">
  <header class="inner-top">
    <div class="in">
      <a class="back" href={base + '/'} aria-label="뒤로가기">&#10094;</a>
    </div>
  </header>

  <main class="inner-body">
    <div class={`page-head${center ? ' center' : ''}`}>
      {flora && (
        <div class="vines" aria-hidden="true">
          <img class="vine vine-l" src={img('vine.svg')} alt="" />
          <img class="vine vine-r" src={img('vine.svg')} alt="" />
        </div>
      )}
      {center && <img class="head-divider" src={img('divider.png')} alt="" aria-hidden="true" />}
      {label && <div class="plabel">{label}</div>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <slot />
  </main>

  <footer class="inner-foot">
    <a href="mailto:subtitle8080@gmail.com">email</a>
    <a href="https://github.com/charlie-morningstar" target="_blank" rel="noopener">github</a>
  </footer>
</Base>

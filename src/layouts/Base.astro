---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const {
  title,
  description = '윈도우 커널·시스템 취약점 분석. 연구와 공부를 기록합니다.',
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:wght@500;600&family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>

---
import Base from './Base.astro';
export interface Props {
  title: string;
  meta?: string;
  backHref?: string;
  backLabel?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, meta = '', backHref = base + '/', backLabel = '← 돌아가기' } = Astro.props;
---
<Base title={title}>
  <main class="parchment-stage">
    <a class="back-link" href={backHref}>{backLabel}</a>
    <article class="parchment">
      {meta && <div class="p-meta">{meta}</div>}
      <h1>{title}</h1>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</Base>
